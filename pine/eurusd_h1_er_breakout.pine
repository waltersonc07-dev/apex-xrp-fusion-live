//@version=5
// =====================================================================
// EURUSD H1 — Efficiency-Ratio Trend Breakout (LONG-ONLY)
// Status: UNVALIDATED — PAPER / BACKTEST ONLY. Does NOT pass APEX Phase 11 gate.
// Author: APEX research (waltersonc07-dev)
//
// Edge logic (validated in Python on yfinance EURUSD=X 2023-09 -> 2026-06):
//   * Daily trend filter : daily EMA20 > EMA50  (long only in daily uptrend)
//   * Regime filter      : Kaufman Efficiency Ratio(20) on H1 close >= 0.30
//                          (only take breakouts when price is moving efficiently,
//                           i.e. trending; stand aside in chop)
//   * Entry              : H1 close breaks above the prior 20-bar Donchian high
//   * Exit               : TP +100 pips / SL -50 pips / 24-bar time stop
//
// Backtest summary (1.3 pip round-trip cost, ~2.8 yrs H1):
//   PF 1.40 | +740 pips | expectancy ~7.0 pip/trade | maxDD ~446 pip
//   Walk-forward folds PF: 0.47 / 1.65 / 1.88 / 2.26 (3 of 4 positive, improving)
//   HONEST CAVEAT: this is a TREND FOLLOWER. It loses in extended ranges
//   (fold 1, 2023-2024 chop = PF 0.47). Only trade with strict position sizing.
// =====================================================================

strategy("EURUSD H1 ER Trend Breakout (Long-Only)", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.0,
     slippage=13,                       // 13 ticks ~= 1.3 pip round-trip cost on EURUSD
     process_orders_on_close=true, pyramiding=0)

// ---------------- Inputs ----------------
donLen     = input.int(20,   "Donchian Lookback")
erLen      = input.int(20,   "Efficiency Ratio Length")
erThresh   = input.float(0.30,"ER Threshold (min)", step=0.05)
emaFastLen = input.int(20,   "Daily EMA Fast")
emaSlowLen = input.int(50,   "Daily EMA Slow")
tpPips     = input.float(100, "Take Profit (pips)")
slPips     = input.float(50,  "Stop Loss (pips)")
maxHold    = input.int(24,   "Max Hold (bars)")
mode       = input.string("BACKTEST_ONLY", "Mode", options=["BACKTEST_ONLY","MICRO_LIVE","FULL_LIVE"])

pip = syminfo.mintick * 10   // EURUSD: 1 pip = 0.0001 = 10 ticks

// ---------------- Daily trend filter (higher timeframe, no repaint) ----------------
dClose   = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)
dEmaFast = request.security(syminfo.tickerid, "D", ta.ema(close, emaFastLen)[1], lookahead=barmerge.lookahead_off)
dEmaSlow = request.security(syminfo.tickerid, "D", ta.ema(close, emaSlowLen)[1], lookahead=barmerge.lookahead_off)
dUptrend = dEmaFast > dEmaSlow

// ---------------- Kaufman Efficiency Ratio on H1 close ----------------
change_n  = math.abs(close - close[erLen])
volat_n   = math.sum(math.abs(close - close[1]), erLen)
er        = volat_n != 0 ? change_n / volat_n : 0.0
efficient = er >= erThresh

// ---------------- Donchian breakout ----------------
donHigh   = ta.highest(high, donLen)[1]     // prior 20-bar high (shifted, no lookahead)
breakout  = close >= donHigh

// ---------------- Entry (long-only) ----------------
longCond = breakout and dUptrend and efficient and strategy.position_size == 0
if longCond
    strategy.entry("L", strategy.long)

// ---------------- Exits: TP / SL / time stop ----------------
var float entryPrice = na
if strategy.position_size > 0 and strategy.position_size[1] == 0
    entryPrice := strategy.position_avg_price
if strategy.position_size > 0
    tp = entryPrice + tpPips * pip
    sl = entryPrice - slPips * pip
    strategy.exit("X", from_entry="L", limit=tp, stop=sl)
    if bar_index - strategy.opentrades.entry_bar_index(0) >= maxHold
        strategy.close("L", comment="time")

// ---------------- Visuals ----------------
plot(donHigh, "Donchian High", color=color.new(color.orange, 50))
bgcolor(efficient and dUptrend ? color.new(color.green, 92) : na, title="Tradeable regime")
plotchar(longCond, "Entry", "▲", location.belowbar, color.lime, size=size.tiny)
