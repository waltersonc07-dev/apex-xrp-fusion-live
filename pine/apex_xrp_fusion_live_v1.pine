//@version=5
strategy("APEX XRP FUSION LIVE v1", overlay=true, initial_capital=input.float(10000, "Initial Capital"), commission_type=strategy.commission.percent, commission_value=input.float(0.05, "Commission %"), slippage=input.int(2, "Slippage Ticks"), process_orders_on_close=true, pyramiding=0)

strategyName = "APEX_XRP_FUSION_LIVE_V1"
riskPct = input.float(0.25, "Risk %", step=0.01)
stAtrLen = input.int(12, "Supertrend ATR Length")
stMult = input.float(3.0, "Supertrend Multiplier")
emaFastLen = input.int(9, "EMA Fast")
emaSlowLen = input.int(21, "EMA Slow")
demaLen = input.int(200, "HTF DEMA Length")
demaTf = input.timeframe("60", "DEMA Timeframe")
atrLen = input.int(12, "ATR Length")
stopAtrMult = input.float(1.5, "Stop ATR Mult")
tpAtrMult = input.float(3.0, "TP ATR Mult")
minRR = input.float(2.0, "Minimum RR")
useFlipExit = input.bool(true, "Use Flip Exit")
useBreakeven = input.bool(true, "Use Breakeven")
fundamentalScore = input.int(16, "Fundamental Score")
allowMicroWhenScoreLow = input.bool(false, "Allow Micro Mode For Score 17-21")
mode = input.string("BACKTEST_ONLY", "Mode", options=["BACKTEST_ONLY", "MICRO_LIVE", "FULL_LIVE"])

r1 = input.float(1.3620, "R1")
r2 = input.float(1.3671, "R2")
r3 = input.float(1.3712, "R3")
r4 = input.float(1.3800, "R4")
r5 = input.float(1.4000, "R5")
r6 = input.float(1.4200, "R6")
r7 = input.float(1.4500, "R7")
s1 = input.float(1.3455, "S1")
s2 = input.float(1.3430, "S2")
s3 = input.float(1.3426, "S3")
s4 = input.float(1.3330, "S4")
s5 = input.float(1.3000, "S5")
s6 = input.float(1.2800, "S6")

[stLine, stDirRaw] = ta.supertrend(stMult, stAtrLen)
stBull = stDirRaw < 0
stBear = stDirRaw > 0
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atrValue = ta.atr(atrLen)

demaCalc(src, len) =>
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    2 * e1 - e2

htfDema = request.security(syminfo.tickerid, demaTf, demaCalc(close, demaLen), barmerge.gaps_off, barmerge.lookahead_off)

nearLevel(price, level, pct) =>
    math.abs(price - level) / price * 100 <= pct

blockedLong = nearLevel(close, r1, 0.25) or nearLevel(close, r2, 0.25) or nearLevel(close, r3, 0.25)
blockedShort = nearLevel(close, s1, 0.25) or nearLevel(close, s2, 0.25) or nearLevel(close, s3, 0.25)
fundamentalAllowed = fundamentalScore >= 17

longStop = close - atrValue * stopAtrMult
longTp = close + atrValue * tpAtrMult
shortStop = close + atrValue * stopAtrMult
shortTp = close - atrValue * tpAtrMult
longRR = (longTp - close) / math.max(close - longStop, syminfo.mintick)
shortRR = (close - shortTp) / math.max(shortStop - close, syminfo.mintick)

longState = stBull and emaFast > emaSlow and close > htfDema and not blockedLong and longRR >= minRR and fundamentalAllowed
shortState = stBear and emaFast < emaSlow and close < htfDema and not blockedShort and shortRR >= minRR and fundamentalAllowed
longSignal = longState and not longState[1]
shortSignal = shortState and not shortState[1]

riskAmount = strategy.equity * riskPct / 100
longQty = riskAmount / math.max(close - longStop, syminfo.mintick)
shortQty = riskAmount / math.max(shortStop - close, syminfo.mintick)

if longSignal
    strategy.entry("Long", strategy.long, qty=longQty)
    strategy.exit("Long TP/SL", "Long", stop=longStop, limit=longTp)

if shortSignal
    strategy.entry("Short", strategy.short, qty=shortQty)
    strategy.exit("Short TP/SL", "Short", stop=shortStop, limit=shortTp)

if useFlipExit and shortSignal
    strategy.close("Long", comment="Flip Exit")

if useFlipExit and longSignal
    strategy.close("Short", comment="Flip Exit")

if useBreakeven and strategy.position_size > 0 and high >= strategy.position_avg_price + (strategy.position_avg_price - longStop)
    strategy.exit("Long BE/TP", "Long", stop=strategy.position_avg_price, limit=longTp)

if useBreakeven and strategy.position_size < 0 and low <= strategy.position_avg_price - (shortStop - strategy.position_avg_price)
    strategy.exit("Short BE/TP", "Short", stop=strategy.position_avg_price, limit=shortTp)

plot(stLine, "Supertrend", color=stBull ? color.green : color.red)
plot(emaFast, "EMA 9", color=color.teal)
plot(emaSlow, "EMA 21", color=color.orange)
plot(htfDema, "HTF DEMA 200", color=color.blue, linewidth=2)
plot(r1, "R1", color=color.new(color.red, 70))
plot(r2, "R2", color=color.new(color.red, 70))
plot(r3, "R3", color=color.new(color.red, 70))
plot(r4, "R4", color=color.new(color.red, 75))
plot(r5, "R5", color=color.new(color.red, 75))
plot(r6, "R6", color=color.new(color.red, 80))
plot(r7, "R7", color=color.new(color.red, 80))
plot(s1, "S1", color=color.new(color.green, 70))
plot(s2, "S2", color=color.new(color.green, 70))
plot(s3, "S3", color=color.new(color.green, 70))
plot(s4, "S4", color=color.new(color.green, 75))
plot(s5, "S5", color=color.new(color.green, 80))
plot(s6, "S6", color=color.new(color.green, 80))

plotshape(longSignal, title="Long Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="LONG")
plotshape(shortSignal, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SHORT")

longJson = '{"strategy":"' + strategyName + '","action":"buy","symbol":"{{ticker}}","timeframe":"{{interval}}","price":"{{close}}","stop_loss":"' + str.tostring(longStop) + '","take_profit":"' + str.tostring(longTp) + '","risk_pct":"' + str.tostring(riskPct) + '","contracts":"' + str.tostring(longQty) + '","signal_id":"{{ticker}}-{{interval}}-{{time}}","timestamp":"{{time}}"}'
shortJson = '{"strategy":"' + strategyName + '","action":"sell","symbol":"{{ticker}}","timeframe":"{{interval}}","price":"{{close}}","stop_loss":"' + str.tostring(shortStop) + '","take_profit":"' + str.tostring(shortTp) + '","risk_pct":"' + str.tostring(riskPct) + '","contracts":"' + str.tostring(shortQty) + '","signal_id":"{{ticker}}-{{interval}}-{{time}}","timestamp":"{{time}}"}'

alertcondition(longSignal, "APEX Long", longJson)
alertcondition(shortSignal, "APEX Short", shortJson)
alertcondition(useFlipExit and (longSignal or shortSignal), "APEX Exit/Flip", '{"strategy":"APEX_XRP_FUSION_LIVE_V1","action":"exit_flip","symbol":"{{ticker}}","timeframe":"{{interval}}","price":"{{close}}","signal_id":"{{ticker}}-{{interval}}-{{time}}","timestamp":"{{time}}"}')

var table dash = table.new(position.top_right, 2, 8, border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Supertrend")
    table.cell(dash, 1, 0, stBull ? "Bullish" : "Bearish", text_color=stBull ? color.green : color.red)
    table.cell(dash, 0, 1, "EMA 9/21")
    table.cell(dash, 1, 1, emaFast > emaSlow ? "Bullish" : "Bearish")
    table.cell(dash, 0, 2, "DEMA 200")
    table.cell(dash, 1, 2, close > htfDema ? "Above" : "Below")
    table.cell(dash, 0, 3, "Setup")
    table.cell(dash, 1, 3, longState ? "Long" : shortState ? "Short" : "None")
    table.cell(dash, 0, 4, "Position")
    table.cell(dash, 1, 4, strategy.position_size > 0 ? "Long" : strategy.position_size < 0 ? "Short" : "Flat")
    table.cell(dash, 0, 5, "Risk %")
    table.cell(dash, 1, 5, str.tostring(riskPct))
    table.cell(dash, 0, 6, "Stop")
    table.cell(dash, 1, 6, longState ? str.tostring(longStop) : shortState ? str.tostring(shortStop) : "n/a")
    table.cell(dash, 0, 7, "TP")
    table.cell(dash, 1, 7, longState ? str.tostring(longTp) : shortState ? str.tostring(shortTp) : "n/a")

